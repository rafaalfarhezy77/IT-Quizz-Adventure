# ==========================================
# Mythic 3.0 - IT Quest Adventure
# File Template Konfigurasi Environment (.env)
# ==========================================
# Salin file ini menjadi '.env' dan sesuaikan nilainya.
# JANGAN PERNAH mengunggah file '.env' asli ke GitHub!

# Kunci rahasia untuk enkripsi session dan token CSRF Flask
SECRET_KEY=ganti-dengan-string-acak-panjang-dan-unik-minimal-32-karakter

# Mode Debug (0 = mati / untuk produksi & hari lomba, 1 = aktif / hanya dev)
FLASK_DEBUG=0

# Keamanan Cookie Session (0 = HTTP untuk LAN lokal, 1 = HTTPS jika memakai SSL/TLS)
SESSION_COOKIE_SECURE=0

# Kredensial akun awal administrator saat menjalankan 'python seed.py'
DEV_ADMIN_USERNAME=admin_panitia
DEV_ADMIN_PASSWORD=ganti-dengan-password-panitia-yang-sangat-kuat

# Kode akses rahasia yang wajib dimasukkan peserta di gerbang awal sebelum memilih pos
PARTICIPANT_ACCESS_CODE=KODE_AKSES_RESMI_LOMBA

# Pengaturan Kuis & Penilaian
TIME_BONUS_PER_SECOND=1.0
MEMBER_ROTATION_COUNT=3
